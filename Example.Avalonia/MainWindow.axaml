<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Example.Avalonia.MainWindow"
        Title="LiteHtmlSharp — rendering demo"
        Width="820" Height="720" RequestedThemeVariant="Light">
  <Grid RowDefinitions="Auto,*,Auto">
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="10" ColumnSpacing="8">
      <Button Content="Home" Click="HomeClicked" />
      <TextBox x:Name="Address" Grid.Column="1" Watermark="Enter a URL" KeyDown="AddressKeyDown" />
      <Button Grid.Column="2" Content="Go" Click="GoClicked" />
    </Grid>
    <ScrollViewer x:Name="HtmlScrollViewer" Grid.Row="1" />
    <Border Grid.Row="2" Background="#E8EDF3" Padding="16,10">
      <TextBlock x:Name="Status" Text="Ready. Try the link, text field, and button." />
    </Border>
  </Grid>
</Window>
