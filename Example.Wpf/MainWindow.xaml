<Window x:Class="Example.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LiteHtmlSharp — WPF rendering demo" Height="760" Width="840">
    <Grid>
        <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer x:Name="ScrollViewer"/>
        <Border Grid.Row="1" Background="#E8EDF3" Padding="16,10">
            <TextBlock x:Name="Status" Foreground="#24334B" Text="Ready. Try the link, text field, and button."/>
        </Border>
    </Grid>
</Window>
